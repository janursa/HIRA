        <mxCell id="wzzd5CX_dV33YkVSsU24-32" value="&lt;font style=&quot;font-size: 36px;&quot;&gt;&lt;b&gt;Covid and aging TFs&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
