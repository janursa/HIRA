# Copy to .env and fill in. HIRA_DIR is derived from the repo location -- don't set it.
HIRA_BASE_DIR=/path/to/heavy/data        # datasets/, prior/, features/ live here
HIRA_RAW_DIR=/path/to/raw/cohorts        # downloaded public cohorts (see README)
# HIRA_SIF=/path/to/hira.sif             # defaults to singularity/hira.sif; set empty to use conda
# HIRA_OP_RAW_FILE=/path/to/op_perturbation_sc_counts.h5ad   # only for the `opsca` cohort
# TASK_GRN_BENCHMARK_DIR=/path/to/task_grn_inference         # only for scripts/prior/acquire.sh
